{
  "name": "nx-realestate",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "schema:frontend": "pnpm --filter @nx/schema build:frontend"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.15.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "@nestjs/core",
      "sharp"
    ],
    "overrides": {
      "multer@2": "2.5.0",
      "body-parser@1": "1.20.9",
      "lodash@4": "4.18.1",
      "js-yaml@4": "4.3.2",
      "@remix-run/router@1": "1.23.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
