{
  "name": "@nx/schema",
  "version": "1.0.0",
  "private": true,
  "description": "Single source of truth for property types, offers, statuses, fields, cities and nearby categories.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:frontend": "tsx scripts/build-frontend.ts",
    "check:frontend": "tsx scripts/build-frontend.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
