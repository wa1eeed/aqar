# Local development (copy to backend/.env). Production values: infra/.env.example
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgresql://nx:nx_dev_password@localhost:5432/nx?schema=public
REDIS_URL=redis://localhost:6379
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 48  (three different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NATIONAL_ID_PEPPER=
SWAGGER_ENABLED=true
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Receipt PDFs (worker): system Chromium. Docker image: /usr/bin/chromium; cloud dev container: /opt/pw-browsers/chromium
# CHROMIUM_PATH=/opt/pw-browsers/chromium
