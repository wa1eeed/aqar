// عقار أونلاين — مخطّط قاعدة البيانات (multi-tenant).
// المصدر: docs/01 + نماذج SEO (docs/07 §13) + تعدّد المشتركين (docs/12).
// كل الحقول المالية بالهللات (BigInt، 1 ريال = 100). الطوابع الزمنية UTC.
//
// العزل: كل جدول مملوك لمشترك يحمل `tenantId` (عمود نصّي مفهرس، بلا علاقة Prisma لتفادي
// عشرات العلاقات العكسية على Tenant). الفرض عبر:
//   1) امتداد Prisma (tenantGuardExtension) يحقن/يفلتر tenantId من TenantContext.
//   2) سياسات RLS في هجرة SQL على كل جدول مملوك.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ═════════════════════════════ Platform (غير مملوك لمشترك) ═════════════════════════════

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // للمسار /<slug> والنطاق الفرعي الافتراضي
  code      String       @unique // بادئة أكواد العقارات، مثل MZ / AQ
  name      String // اسم المكتب العقاري
  status    TenantStatus @default(trial)
  planKey   String?
  ownerName String?
  ownerEmail String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  domains       TenantDomain[]
  subscription  Subscription?
}

enum DomainKind {
  path
  subdomain
  custom
}

model TenantDomain {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host       String     @unique // aqar-office.com أو office.manzilah.sa
  kind       DomainKind @default(custom)
  isPrimary  Boolean    @default(false)
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([tenantId])
}

model Plan {
  id           String   @id @default(cuid())
  key          String   @unique // free | basic | pro
  nameAr       String
  priceMonthly BigInt   @default(0) // هللات
  isActive     Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  entitlements  PlanEntitlement[]
}

// ───────── محرّك الاستحقاقات (Entitlements) — مفصول عن RBAC وعن الفوترة ─────────

// نوع الاستحقاق: تشغيل/إيقاف، حدّ عددي، أو استهلاك مقيس.
enum FeatureType {
  boolean
  limit
  metered
}

// سجلّ الميزات (Feature Catalog) — المصدر = الكود (FEATURE_CATALOG)، يُبذر هنا.
// لا تُخترع ميزة من اللوحة؛ تُفعَّل فقط ميزات مبنية برمجياً.
model Feature {
  key         String      @id // مثل auctions.enabled, staff.max, properties.max
  nameAr      String
  description String?
  type        FeatureType @default(boolean)
  category    String?
  sort        Int         @default(0)
  createdAt   DateTime    @default(now())
}

// ربط باقة بميزة وقيمتها (true/false أو عدد الحدّ). value = JSON scalar.
model PlanEntitlement {
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  value      Json

  @@id([planId, featureKey])
  @@index([featureKey])
}

// استثناءات/إضافات (add-ons) لكل مشترك تَغلب قيمة الباقة.
model TenantEntitlement {
  tenantId   String
  featureKey String
  value      Json
  expiresAt  DateTime?
  updatedById String?
  updatedAt  DateTime  @updatedAt

  @@id([tenantId, featureKey])
  @@index([tenantId])
}

// عدّادات الاستهلاك (للحدود والاستهلاك المدفوع). period=null تراكمي، أو YYYY-MM.
model UsageCounter {
  tenantId  String
  key       String
  value     Int      @default(0)
  period    String?
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
  @@index([tenantId])
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

model Subscription {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(trialing)
  currentPeriodEnd DateTime?
  cancelAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model PlatformAdmin {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  totpSecretEnc Bytes?
  totpEnabled   Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// تكاملات على مستوى المنصّة (مشتركة للجميع): R2، البريد البنيوي، الخرائط المجانية.
model PlatformIntegration {
  key             String            @id // storage.r2 | email.resend | maps.osm | places.overpass
  category        String
  enabled         Boolean           @default(false)
  config          Json              @default("{}")
  secretsEnc      Bytes?
  secretsHint     Json?
  health          IntegrationHealth @default(unknown)
  healthCheckedAt DateTime?
  lastError       String?
  updatedById     String?
  updatedAt       DateTime          @updatedAt
}

// مرجعية مشتركة بين كل المشتركين (تُبذر من packages/schema).
model City {
  id         String     @id
  nameAr     String
  lat        Decimal    @db.Decimal(9, 6)
  lng        Decimal    @db.Decimal(9, 6)
  sort       Int        @default(0)
  isActive   Boolean    @default(true)
  districts  District[]
  properties Property[]
}

model District {
  id         String     @id @default(cuid())
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  nameAr     String
  lat        Decimal?   @db.Decimal(9, 6)
  lng        Decimal?   @db.Decimal(9, 6)
  isActive   Boolean    @default(true)
  properties Property[]

  @@unique([cityId, nameAr])
}

// ═════════════════════════════ Identity (مملوك لمشترك) ═════════════════════════════

model Role {
  id          String      @id @default(cuid())
  tenantId    String
  key         String // owner | admin | sales_manager | agent | finance | content_editor | custom_*
  nameAr      String
  isSystem    Boolean     @default(true)
  permissions String[]
  users       StaffUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model StaffUser {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  email         String
  phone         String?
  whatsapp      String?
  title         String?
  falLicense    String?
  avatarKey     String?
  passwordHash  String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  showOnWebsite Boolean   @default(true)
  totpSecretEnc Bytes?
  totpEnabled   Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  properties    Property[] @relation("PropertyAgent")
  assignedLeads Lead[]     @relation("LeadAssignee")
  viewings      Viewing[]  @relation("ViewingAgent")

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum CustomerStatus {
  active
  blocked
  deleted
}

model Customer {
  id               String         @id @default(cuid())
  tenantId         String
  name             String
  email            String?
  phone            String?
  passwordHash     String?
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  nafathVerifiedAt DateTime?
  nationalIdHash   String?
  nationalIdLast4  String?
  status           CustomerStatus @default(active)
  marketingConsent Boolean        @default(false)
  consentAt        DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  favorites     Favorite[]
  savedSearches SavedSearch[]
  leads         Lead[]
  viewings      Viewing[]
  bookings      Booking[]
  wallet        Wallet?

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

enum SubjectType {
  staff
  customer
  platform
}

model RefreshToken {
  id          String      @id @default(cuid())
  tenantId    String? // null لرموز السوبر-أدمن (platform)
  subjectType SubjectType
  subjectId   String
  tokenHash   String      @unique
  family      String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId])
  @@index([tenantId])
}

enum OtpChannel {
  email
  sms
}

enum OtpPurpose {
  login
  verify_email
  verify_phone
  reset_password
  staff_2fa_email
}

model OtpCode {
  id          String     @id @default(cuid())
  tenantId    String?
  channel     OtpChannel
  destination String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
  @@index([tenantId])
}

// ═════════════════════════════ Listings (مملوك لمشترك) ═════════════════════════════

enum PropertyOffer {
  sale
  rent
  investment
}

enum PropertyStatus {
  available
  negotiation
  reserved
  sold
  rented
}

enum RentPeriod {
  yearly
  monthly
  daily
}

enum ListingVisibility {
  draft
  published
  archived
}

enum AdLicenseCheck {
  unknown
  valid
  expiring
  expired
  invalid
}

model Property {
  id                 Int               @id @default(autoincrement()) // مفتاح داخلي عام (غير مكشوف علناً)
  tenantId           String
  code               String // {tenant.code}-{YY}-{RAND6} — فريد لكل مشترك
  slug               String
  type               String
  offer              PropertyOffer
  status             PropertyStatus    @default(available)
  visibility         ListingVisibility @default(draft)
  featured           Boolean           @default(false)
  title              String
  description        String
  cityId             String
  city               City              @relation(fields: [cityId], references: [id])
  districtId         String
  district           District          @relation(fields: [districtId], references: [id])
  lat                Decimal           @db.Decimal(9, 6)
  lng                Decimal           @db.Decimal(9, 6)
  showExactLocation  Boolean           @default(true)
  price              BigInt
  rentPeriod         RentPeriod?
  negotiable         Boolean           @default(false)
  annualisedPrice    BigInt
  pricePerMeter      BigInt?
  area               Int
  bedrooms           Int?
  bathrooms          Int?
  roi                Decimal?          @db.Decimal(5, 2)
  specs              Json
  adLicenseNo        String
  falLicenseNo       String
  licenseExpiry      DateTime?
  adLicenseCheck     AdLicenseCheck    @default(unknown)
  adLicenseCheckedAt DateTime?
  bookingEnabled     Boolean           @default(true)
  paymentPolicy      Json?
  seoTitle           String?
  seoDescription     String?
  focusKeyword       String?
  keywords           String[]
  ogImageKey         String?
  noindex            Boolean           @default(false)
  agentId            String
  agent              StaffUser         @relation("PropertyAgent", fields: [agentId], references: [id])
  createdById        String
  updatedById        String?
  publishedAt        DateTime?
  viewCount          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  media         PropertyMedia[]
  statusHistory PropertyStatusHistory[]
  favorites     Favorite[]
  leads         Lead[]
  viewings      Viewing[]
  bookings      Booking[]
  nearbyCache   NearbyCache[]
  auctions      Auction[]

  @@unique([tenantId, code])
  @@index([tenantId, visibility, status, offer, type])
  @@index([tenantId, cityId, districtId])
  @@index([tenantId, annualisedPrice])
  @@index([tenantId, createdAt])
}

enum MediaKind {
  photo
  floor_plan
  document
  video_url
}

enum MediaStatus {
  processing
  ready
  failed
}

model PropertyMedia {
  id          String      @id @default(cuid())
  tenantId    String
  propertyId  Int
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind        MediaKind   @default(photo)
  originalKey String? // tenants/{tenantId}/properties/{propertyId}/...
  variants    Json?
  externalUrl String?
  width       Int?
  height      Int?
  altAr       String?
  sort        Int         @default(0)
  isCover     Boolean     @default(false)
  status      MediaStatus @default(processing)
  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([propertyId, sort])
}

model PropertyStatusHistory {
  id         String         @id @default(cuid())
  tenantId   String
  propertyId Int
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  from       PropertyStatus
  to         PropertyStatus
  reason     String?
  bookingId  String?
  actorType  String
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([tenantId])
}

model NearbyCache {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider   String
  radius     Int
  items      Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([propertyId, provider, radius])
  @@index([tenantId])
}

model Favorite {
  tenantId   String
  customerId String
  propertyId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, propertyId])
  @@index([tenantId])
}

model SavedSearch {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name           String
  query          Json
  alertEnabled   Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
}

// ═════════════════════════════ CRM (مملوك لمشترك) ═════════════════════════════

enum LeadType {
  viewing
  waitlist
  buy
  rent
  list
  invest
  manage
  contact
}

enum LeadStage {
  new
  contacted
  viewing
  negotiation
  won
  lost
}

enum LeadSource {
  website
  whatsapp
  phone
  walk_in
  admin
}

model Lead {
  id            String     @id @default(cuid())
  tenantId      String
  number        String // L-{YY}-{RAND6}
  type          LeadType
  stage         LeadStage  @default(new)
  source        LeadSource @default(website)
  propertyId    Int?
  property      Property?  @relation(fields: [propertyId], references: [id])
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  name          String
  phone         String
  email         String?
  cityId        String?
  propertyType  String?
  budget        BigInt?
  message       String?
  preferredDate DateTime?
  preferredSlot String?
  assignedToId  String?
  assignedTo    StaffUser? @relation("LeadAssignee", fields: [assignedToId], references: [id])
  lostReason    String?
  consent       Boolean    @default(true)
  utm           Json?
  meta          Json?
  closedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  activities LeadActivity[]
  viewings   Viewing[]

  @@unique([tenantId, number])
  @@index([tenantId, stage, assignedToId])
  @@index([tenantId, createdAt])
}

enum LeadActivityType {
  note
  call
  whatsapp
  email
  stage_change
  assignment
  viewing
  booking
  system
}

model LeadActivity {
  id        String           @id @default(cuid())
  tenantId  String
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  body      String?
  meta      Json?
  actorId   String?
  createdAt DateTime         @default(now())

  @@index([tenantId])
}

enum ViewingStatus {
  requested
  confirmed
  completed
  no_show
  cancelled
}

model Viewing {
  id          String        @id @default(cuid())
  tenantId    String
  propertyId  Int
  property    Property      @relation(fields: [propertyId], references: [id])
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  agentId     String
  agent       StaffUser     @relation("ViewingAgent", fields: [agentId], references: [id])
  scheduledAt DateTime
  durationMin Int           @default(45)
  status      ViewingStatus @default(requested)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, agentId, scheduledAt])
}

// ═════════════════════════════ Bookings & payments (مملوك لمشترك) ═════════════════════════════

enum BookingStatus {
  pending_payment
  awaiting_transfer_review
  confirmed
  completed
  cancelled
  expired
  refunded
}

enum PaymentType {
  deposit
  full
}

enum PaymentMethod {
  moyasar
  bank_transfer
  rize
}

model Booking {
  id                 String        @id @default(cuid())
  tenantId           String
  number             String // B-{YY}-{RAND6}
  propertyId         Int
  property           Property      @relation(fields: [propertyId], references: [id])
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  offerSnapshot      PropertyOffer
  priceSnapshot      BigInt
  rentPeriodSnapshot RentPeriod?
  paymentType        PaymentType
  paymentMethod      PaymentMethod
  amountDue          BigInt
  amountPaid         BigInt        @default(0)
  status             BookingStatus @default(pending_payment)
  holdExpiresAt      DateTime
  termsVersion       String
  termsAcceptedAt    DateTime
  customerNotes      String?
  cancelReason       String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status, holdExpiresAt])
  @@index([tenantId, propertyId, status])
}

enum PaymentStatus {
  initiated
  pending
  paid
  failed
  under_review
  rejected
  cancelled
  refunded
  partially_refunded
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(initiated)
  amount            BigInt
  refundedAmount    BigInt        @default(0)
  currency          String        @default("SAR")
  idempotencyKey    String        @unique
  providerPaymentId String?
  providerInvoiceId String?
  providerStatus    String?
  providerUrl       String?
  providerPayload   Json?
  receiptNumber     String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events   PaymentEvent[]
  transfer BankTransferSubmission?

  @@unique([tenantId, providerPaymentId])
  @@unique([tenantId, providerInvoiceId])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  tenantId  String
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model BankAccount {
  id              String   @id @default(cuid())
  tenantId        String
  bankName        String
  beneficiaryName String
  iban            String
  accountNumber   String?
  swift           String?
  isActive        Boolean  @default(true)
  sort            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions BankTransferSubmission[]

  @@index([tenantId])
}

enum TransferStatus {
  submitted
  approved
  rejected
}

model BankTransferSubmission {
  id                String         @id @default(cuid())
  tenantId          String
  paymentId         String         @unique
  payment           Payment        @relation(fields: [paymentId], references: [id])
  bankAccountId     String
  bankAccount       BankAccount    @relation(fields: [bankAccountId], references: [id])
  senderName        String
  senderBank        String
  transferReference String?
  transferredAt     DateTime
  amount            BigInt
  receiptKey        String
  status            TransferStatus @default(submitted)
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime       @default(now())

  @@index([tenantId])
}

// ═════════════════════════════ Notifications & email (مملوك لمشترك) ═════════════════════════════

enum NotificationPriority {
  low
  normal
  high
}

model Notification {
  id            String               @id @default(cuid())
  tenantId      String
  recipientType SubjectType
  recipientId   String
  eventKey      String
  title         String
  body          String
  link          String?
  data          Json?
  priority      NotificationPriority @default(normal)
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())

  @@index([tenantId, recipientType, recipientId, readAt])
  @@index([tenantId, createdAt])
}

model NotificationPreference {
  tenantId      String
  recipientType SubjectType
  recipientId   String
  eventKey      String
  inApp         Boolean     @default(true)
  email         Boolean     @default(true)
  sms           Boolean     @default(false)

  @@id([tenantId, recipientType, recipientId, eventKey])
}

enum EmailStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
}

model EmailLog {
  id          String      @id @default(cuid())
  tenantId    String
  to          String
  template    String
  subject     String
  resendId    String?     @unique
  status      EmailStatus @default(queued)
  error       String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
}

// ═════════════════════════════ Settings, integrations, audit (مملوك لمشترك) ═════════════════════════════

model SettingsSection {
  tenantId    String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([tenantId, key])
}

enum IntegrationEnv {
  sandbox
  live
}

enum IntegrationHealth {
  unknown
  ok
  degraded
  down
}

// تكاملات المشترك (لكل مكتب مفاتيحه): Moyasar، Rize، REGA، Ejar، Nafath، Nafith، Google.
model Integration {
  tenantId        String
  key             String
  category        String
  enabled         Boolean           @default(false)
  environment     IntegrationEnv    @default(sandbox)
  config          Json              @default("{}")
  secretsEnc      Bytes?
  secretsHint     Json?
  health          IntegrationHealth @default(unknown)
  healthCheckedAt DateTime?
  lastError       String?
  updatedById     String?
  updatedAt       DateTime          @updatedAt

  @@id([tenantId, key])
}

model IntegrationCallLog {
  id             String   @id @default(cuid())
  tenantId       String?
  integrationKey String
  operation      String
  success        Boolean
  httpStatus     Int?
  latencyMs      Int
  correlationId  String
  request        Json?
  response       Json?
  error          String?
  createdAt      DateTime @default(now())

  @@index([tenantId, integrationKey, createdAt])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  tenantId       String?
  provider       String
  externalId     String
  type           String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([tenantId])
}

// سجلّ التدقيق: tenantId=null لأفعال المنصّة (السوبر-أدمن).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorType  String // platform | staff | customer | system
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([createdAt])
}

model Counter {
  tenantId String
  key      String // lead | booking:2026 | receipt:2026
  value    Int    @default(0)

  @@id([tenantId, key])
}

// ═════════════════════════════ SEO (docs/07 §13, مملوك لمشترك) ═════════════════════════════

model SeoLandingPage {
  id              String   @id @default(cuid())
  tenantId        String
  path            String
  filters         Json
  h1              String
  introHtml       String
  faqIds          String[]
  focusKeyword    String?
  keywords        String[]
  metaTitle       String?
  metaDescription String?
  ogImageKey      String?
  indexable       Boolean  @default(true)
  inSitemap       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, path])
  @@index([tenantId])
}

model SeoPageMeta {
  tenantId        String
  key             String
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  keywords        String[]
  ogImageKey      String?
  faqIds          String[]
  noindex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@id([tenantId, key])
}

model SeoKeyword {
  id         String   @id @default(cuid())
  tenantId   String
  keyword    String
  intent     String
  group      String?
  targetPath String?
  priority   Int      @default(2)
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, keyword])
  @@index([tenantId])
}

model SeoFaq {
  id          String   @id @default(cuid())
  tenantId    String
  question    String
  answerShort String
  answerHtml  String?
  scope       String[]
  sort        Int      @default(0)
  isActive    Boolean  @default(true)

  @@index([tenantId])
}

model SeoRedirect {
  id        String   @id @default(cuid())
  tenantId  String
  fromPath  String
  toPath    String
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([tenantId, fromPath])
  @@index([tenantId])
}

model Seo404 {
  tenantId String
  path     String
  hits     Int      @default(1)
  referrer String?
  lastSeen DateTime @default(now())

  @@id([tenantId, path])
}

// ═════════════════════════════ Auctions (feature flag، مملوك لمشترك) ═════════════════════════════

enum AuctionStatus {
  draft
  scheduled
  live
  ended
  awarded
  cancelled
}

model Auction {
  id                 String        @id @default(cuid())
  tenantId           String
  propertyId         Int
  property           Property      @relation(fields: [propertyId], references: [id])
  regaAuctionLicense String
  startsAt           DateTime
  endsAt             DateTime
  startingPrice      BigInt
  minIncrement       BigInt
  reservePrice       BigInt?
  depositAmount      BigInt
  antiSnipingSec     Int           @default(120)
  status             AuctionStatus @default(draft)
  winnerCustomerId   String?
  winningBidId       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bids          AuctionBid[]
  registrations AuctionRegistration[]

  @@index([tenantId])
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

enum GuaranteeType {
  wallet
  nafith
}

model AuctionRegistration {
  id            String             @id @default(cuid())
  tenantId      String
  auctionId     String
  auction       Auction            @relation(fields: [auctionId], references: [id])
  customerId    String
  guaranteeType GuaranteeType
  nafithNoteId  String?
  walletHoldId  String?
  status        RegistrationStatus @default(pending)
  bidderAlias   String
  createdAt     DateTime           @default(now())

  @@unique([auctionId, customerId])
  @@index([tenantId])
}

model AuctionBid {
  id         String   @id @default(cuid())
  tenantId   String
  auctionId  String
  auction    Auction  @relation(fields: [auctionId], references: [id])
  customerId String
  amount     BigInt
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([auctionId, amount])
}

model Wallet {
  id           String              @id @default(cuid())
  tenantId     String
  customerId   String              @unique
  customer     Customer            @relation(fields: [customerId], references: [id])
  balance      BigInt              @default(0)
  held         BigInt              @default(0)
  transactions WalletTransaction[]

  @@index([tenantId])
}

enum WalletTxType {
  topup
  hold
  release
  capture
  refund
  adjustment
}

model WalletTransaction {
  id        String       @id @default(cuid())
  tenantId  String
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id])
  type      WalletTxType
  amount    BigInt
  reference String?
  createdAt DateTime     @default(now())

  @@index([tenantId])
}
