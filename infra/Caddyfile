# NX Real Estate — single entry point (docs/10 §3).
#   SITE_ADDRESS=example.sa          standalone VPS: Caddy obtains TLS certificates itself
#   SITE_ADDRESS=:80                 behind another TLS proxy (e.g. Coolify/Traefik) or local dev
# Routes:  /api/* /ws*  → api:3000      /admin/*  → admin SPA      /*  → public site
# SEO routes (/property/:id-:slug, /properties/:city…, sitemaps, robots.txt, llms.txt, feeds,
# theme.css) are routed to the API when they are implemented (Phases 3 and 6).
{
	admin off
	servers {
		# Keep the client IP from trusted proxies only (private networks); otherwise it is replaced.
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self \"https://*.moyasar.com\"), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

{$SITE_ADDRESS::80} {
	import security_headers
	encode zstd gzip

	# Largest legitimate body: bank transfer receipt (10 MB) + form fields.
	request_body {
		max_size 12MB
	}

	# ───────────── API + WebSocket ─────────────
	@api path /api/* /ws /ws/*
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ───────────── Admin SPA ─────────────
	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.r2.cloudflarestorage.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Robots-Tag "noindex, nofollow"
			Cache-Control "no-cache"
		}
		# Vite assets are content-hashed.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# ───────────── Public site ─────────────
	handle {
		root * /srv/frontend
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://maps.googleapis.com https://cdn.moyasar.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://maps.gstatic.com https://maps.googleapis.com {$CDN_ORIGIN}; connect-src 'self' https://api.moyasar.com; frame-src https://*.moyasar.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Clean URLs: /about.html → /about, /index(.html) → /, trailing slash removed. Query strings
		# (e.g. /properties.html?offer=rent) are kept so old shared links still work.
		route {
			# Never serve hidden files, docs or build files (first, before any file lookup).
			@private path */.* *.md /Dockerfile /deploy/*
			error @private 404

			@index path /index /index.html
			@hasQuery expression {query} != ""
			@htmlext path_regexp htmlext ^/(.+)\.html$
			@slash path_regexp slash ^(/.+)/$
			handle @index {
				redir @hasQuery /?{query} 301
				redir * / 301
			}
			handle @htmlext {
				redir @hasQuery /{re.htmlext.1}?{query} 301
				redir * /{re.htmlext.1} 301
			}
			handle @slash {
				redir @hasQuery {re.slash.1}?{query} 301
				redir * {re.slash.1} 301
			}
			# Property pages: /property/1001-<slug> → property.html (SSR meta arrives in Phase 6).
			@propertyPage path_regexp propertyPage ^/property/[0-9]+(-[^/]*)?$
			rewrite @propertyPage /property.html
			# «حسابي»: /account → account/index.html (a directory, so no {path}.html match).
			@accountHome path /account
			rewrite @accountHome /account/index.html
			# Inside the same route so redirects see the original path, before /about → /about.html.
			try_files {path} {path}.html
			file_server
		}

		@images path *.jpg *.jpeg *.png *.webp *.svg *.ico *.woff2
		header @images Cache-Control "public, max-age=2592000"
		@code path *.css *.js
		header @code Cache-Control "public, max-age=3600"
	}

	handle_errors 404 {
		root * /srv/frontend
		rewrite * /404.html
		file_server
	}
}
