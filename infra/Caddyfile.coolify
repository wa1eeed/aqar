# عقار أونلاين — Caddy خلف بروكسي Coolify (Traefik يتولّى الدومين وTLS).
# يستمع HTTP فقط على :80 داخل الشبكة، ويوجّه: API + لوحة الإدارة + الواجهة العامة.
# تعدّد المستأجرين يعمل عبر ترويسة Host (يحلّها الباكند) إن وُجّهت النطاقات الفرعية إلى هذه الخدمة في Coolify.

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API + مسارات يخدمها الـ backend (SSR، خرائط الموقع، robots، theme.css…)
	@api path /api/* /ws* /property/* /properties/* /sitemap*.xml /robots.txt /llms.txt /feeds/* /theme.css
	handle @api {
		reverse_proxy api:3000
	}

	# لوحة التحكم (SPA) — base /admin/
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# واجهة المنصة التسويقية — على الجذر aqaar.online و www فقط
	@platform host aqaar.online www.aqaar.online
	handle @platform {
		root * /srv/platform
		try_files {path} {path}.html /index.html
		file_server
	}

	# مواقع المكاتب (storefront) — النطاقات الفرعية والمخصّصة
	# جذر الموقع → index.html
	@root path /
	handle @root {
		root * /srv/frontend
		rewrite * /index.html
		file_server
	}

	# الواجهة العامة الثابتة (clean URLs + فهارس المجلدات مثل /account)
	handle {
		root * /srv/frontend
		try_files {path} {path}.html {path}/index.html /404.html
		file_server
	}
}
