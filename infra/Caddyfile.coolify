# عقار أونلاين — Caddy خلف بروكسي Coolify (Traefik يتولّى الدومين وTLS).
# يستمع HTTP فقط على :80 داخل الشبكة، ويوجّه: API + لوحة الإدارة + الواجهة العامة.
# تعدّد المستأجرين يعمل عبر ترويسة Host (يحلّها الباكند) إن وُجّهت النطاقات الفرعية إلى هذه الخدمة في Coolify.

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API + مسارات يخدمها الـ backend (SSR، خرائط الموقع، robots، theme.css…)
	@api path /api/* /ws* /property/* /properties/* /sitemap*.xml /robots.txt /llms.txt /feeds/* /theme.css
	handle @api {
		reverse_proxy api:3000
	}

	# رابط موحّد قصير لدخول المكاتب: /login → /admin/login
	@loginRedir path /login /login/
	handle @loginRedir {
		redir * /admin/login 308
	}

	# /admin بلا شرطة → /admin/ (وإلا يسقط على الواجهة التسويقية)
	@adminRoot path /admin
	handle @adminRoot {
		redir * /admin/ 308
	}

	# لوحة التحكم (SPA) — base /admin/
	# الأصول المُبصومة تُخزّن طويلاً؛ صفحة الـSPA (index.html) لا تُخزّن أبداً
	# حتى لا تبقى نسخة قديمة تُظهر صفحة فارغة.
	handle_path /admin/* {
		root * /srv/admin
		@adminAsset path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.jpeg *.svg *.ico *.map *.webp
		header @adminAsset Cache-Control "public, max-age=31536000, immutable"
		@adminDoc not path *.js *.css *.woff2 *.woff *.ttf *.png *.jpg *.jpeg *.svg *.ico *.map *.webp
		header @adminDoc Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	# واجهة المنصة التسويقية — على الجذر aqaar.online و www فقط
	@platform host aqaar.online www.aqaar.online
	handle @platform {
		root * /srv/platform
		try_files {path} {path}.html /index.html
		file_server
	}

	# مواقع المكاتب (storefront) — النطاقات الفرعية والمخصّصة
	# جذر الموقع → index.html
	@root path /
	handle @root {
		root * /srv/frontend
		rewrite * /index.html
		file_server
	}

	# الواجهة العامة الثابتة (clean URLs + فهارس المجلدات مثل /account)
	handle {
		root * /srv/frontend
		try_files {path} {path}.html {path}/index.html /404.html
		file_server
	}
}
