# ═════════════ منزلة — متغيّرات البيئة (انسخ إلى infra/.env واملأ القيم) ═════════════

# ── الأساس ──
NODE_ENV=production
PORT=3000
# نطاق المنصة الأساسي (للنطاقات الفرعية للمشتركين <slug>.<base> وتحديد المشترك)
PLATFORM_BASE_DOMAIN=manzilah.example.com
# أصول CORS المسموحة (مفصولة بفواصل)؛ اتركها فارغة للسماح بأصل الطلب
CORS_ORIGINS=

# ── PostgreSQL ──
POSTGRES_USER=manzilah
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=manzilah
DATABASE_URL=postgresql://manzilah:change_me_strong@postgres:5432/manzilah?schema=public

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── أسرار ── (ولّدها: openssl rand -hex 32)
# مفتاح تشفير أسرار التكاملات (AES-256-GCM): 32 بايت (hex 64 أو base64) أو نص يُشتق منه
APP_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Caddy / TLS ──
ACME_EMAIL=ops@example.com
# نقطة تحقّق النطاقات المخصّصة لـ on-demand TLS (داخلية)
ONDEMAND_ASK_URL=http://api:3000/api/v1/platform/domains/check

# ── بذر المنصة والمشترك التجريبي ──
SEED_PLATFORM_ADMIN_EMAIL=superadmin@example.com
SEED_PLATFORM_ADMIN_NAME=مشغّل المنصّة
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_TENANT_SLUG=demo
SEED_TENANT_CODE=MZ
SEED_TENANT_NAME=منزلة العقارية
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=مالك المكتب
SEED_OWNER_PASSWORD=

# ── تكاملات المنصة (مشتركة؛ تُدار أيضاً من لوحة السوبر-أدمن، مُشفّرة) ──
# Cloudflare R2 (تخزين موحّد، مجلد لكل مشترك tenants/{tenantId}/…)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=uploads
R2_BUCKET_MEDIA=media
R2_PUBLIC_BASE=
# Resend (البريد)
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com
