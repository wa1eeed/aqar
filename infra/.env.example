# ─── NX Real Estate — production environment (docs/10 §1). Copy to infra/.env and fill every value.
# Never commit the filled file. Generate secrets with the commands shown.

# Public URL of the site (https in production).
PUBLIC_URL=https://example.sa
# Address Caddy serves. A domain → automatic HTTPS. ":80" when another proxy terminates TLS (Coolify).
SITE_ADDRESS=example.sa
HTTP_PORT=80
HTTPS_PORT=443
# Reverse proxies in front of the API: 1 = Caddy only, 2 = Coolify/Traefik + Caddy.
TRUST_PROXY_HOPS=1
# Media CDN origin allowed by the CSP, e.g. https://cdn.example.sa (empty until R2 is configured).
CDN_ORIGIN=

NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false

# Database / cache — openssl rand -hex 24
POSTGRES_USER=nx
POSTGRES_DB=nx
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Encryption key for integration secrets (AES-256-GCM) — openssl rand -base64 32
APP_ENCRYPTION_KEY=
# JWT secrets and national-ID pepper — openssl rand -base64 48 (three different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NATIONAL_ID_PEPPER=

# First owner account (created once; password change + 2FA forced on first login). ≥ 12 characters.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Image names when pulling from a registry (CI pushes ghcr.io/<owner>/nx-*)
IMAGE_PREFIX=nx
IMAGE_TAG=latest
